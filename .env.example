# Copy to .env and fill in. Never commit .env.
# Everything except VITE_* is server-side only.

# Muse (transcription + constraint extraction)
MUSE_API_KEY=
MUSE_BASE_URL=
MUSE_MODEL=

# Gemini (alternative transcription provider)
GEMINI_API_KEY=

# SerpApi (Google Maps / Local + Events)
SERPAPI_KEY=

# Which provider transcribes audio: muse | gemini
TRANSCRIBE_PROVIDER=muse

# Backend port
PORT=8787

# Frontend -> backend base URL (shipped to the browser; never put secrets in VITE_*)
VITE_API_URL=http://localhost:8787
